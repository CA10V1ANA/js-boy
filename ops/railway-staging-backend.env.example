# Referencias entre servicos Railway. Ajuste o nome "Postgres" se o servico tiver outro nome.
SPRING_PROFILES_ACTIVE=staging
SPRING_DATASOURCE_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
SPRING_DATASOURCE_USERNAME=${{Postgres.PGUSER}}
SPRING_DATASOURCE_PASSWORD=${{Postgres.PGPASSWORD}}

# Gere um valor aleatorio e mantenha como variavel sealed.
JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
BUSINESS_TIME_ZONE=America/Fortaleza
MANAGEMENT_PORT=9090

# Somente no primeiro deploy. Depois defina false e remova as duas credenciais SEED_*.
APP_BOOTSTRAP_OWNER_ENABLED=true
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Homologacao funcional sem provedores externos.
APP_STORAGE_PROVIDER=local
APP_STORAGE_LOCAL_ROOT=/var/lib/jsboy/proofs
APP_STORAGE_MAX_FILE_BYTES=5242880
APP_PROOF_OTP_PROVIDER=local
APP_NOTIFICATIONS_PROVIDER=local
APP_PASSWORD_RESET_PROVIDER=local

# O volume Railway nasce como root; o entrypoint corrige a posse e volta ao UID 10001.
RAILWAY_RUN_UID=0