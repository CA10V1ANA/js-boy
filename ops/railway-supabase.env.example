# Modelo para a API Railway. Credenciais reais ficam somente nas variaveis sealed.
# Use projetos e segredos distintos para staging e prod. Nunca preencha este arquivo no Git.
SPRING_PROFILES_ACTIVE=staging
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://<host-do-session-pooler>:5432/postgres?sslmode=verify-full&sslrootcert=/tmp/jsboy-db-root.crt
SPRING_DATASOURCE_USERNAME=<usuario-fornecido-pelo-supabase>
SPRING_DATASOURCE_PASSWORD=
# Cole o certificado CA publico do painel de conexao; o entrypoint cria o arquivo indicado na URL.
DB_SSL_ROOT_CERT_PEM=
DB_POOL_MAX_SIZE=8
DB_POOL_MIN_IDLE=2
JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://homolog.seudominio.com.br
PUBLIC_FRONTEND_URL=https://homolog.seudominio.com.br
BUSINESS_TIME_ZONE=America/Fortaleza
MANAGEMENT_PORT=9090
APP_BOOTSTRAP_OWNER_ENABLED=false
# Somente no primeiro inicio de um banco novo e vazio, habilite o bootstrap e preencha SEED_*.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
APP_STORAGE_PROVIDER=supabase-s3
SUPABASE_STORAGE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_STORAGE_S3_REGION=<regiao-fornecida-pelo-supabase>
SUPABASE_STORAGE_BUCKET=<bucket-privado-do-ambiente>
SUPABASE_STORAGE_S3_ACCESS_KEY_ID=
SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY=
APP_PROOF_OTP_PROVIDER=disabled
APP_NOTIFICATIONS_PROVIDER=resend
APP_PASSWORD_RESET_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=JS Boy <notificacoes@seudominio.com.br>
# SOMENTE se houver cobrancas antigas a conciliar neste banco:
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Cadastro de clientes e chat. Client ID Google é público; não é uma chave secreta.
GOOGLE_CLIENT_ID=
CHAT_POST_COMPLETION_HOURS=48
CHAT_MAX_CHARS=2000
CHAT_SENDS_PER_MINUTE=20
