# Copie para .env somente no ambiente local. Nunca versione o arquivo preenchido.
# Os campos vazios são intencionais: defina valores próprios antes de iniciar.

POSTGRES_DB=jsboy_local
POSTGRES_USER=jsboy_local
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

JWT_SECRET=
JWT_EXPIRATION_MINUTES=15
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
H2_CONSOLE_ENABLED=false
SWAGGER_ENABLED=true

BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080

# Dados comerciais são opcionais. Deixe vazio para não exibir informação fictícia.
VITE_BUSINESS_PHONE=
VITE_BUSINESS_WHATSAPP=
VITE_BUSINESS_EMAIL=
VITE_BUSINESS_CITY=
VITE_BUSINESS_INSTAGRAM=
VITE_BUSINESS_HOURS=

# P2/P3 — desenvolvimento seguro. Produção usa secret manager/config tree.
APP_STORAGE_PROVIDER=local
APP_STORAGE_LOCAL_ROOT=
APP_STORAGE_MAX_FILE_BYTES=5242880
APP_NOTIFICATIONS_PROVIDER=local
APP_NOTIFICATIONS_POLL_MS=30000
APP_PASSWORD_RESET_PROVIDER=local
REFRESH_TOKEN_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
BUSINESS_TIME_ZONE=America/Fortaleza
MANAGEMENT_PORT=9090